# ==============================================================================
# Krishi Market — Root Environment Configuration Template
# Direct Farmer-to-Consumer Agri Marketplace
#
# INSTRUCTIONS:
# Copy this file to .env in local development, or supply these variables
# through your hosting provider (Vercel, Netlify, Render, Railway, AWS, etc.).
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Node Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
# Port on which the Express.js server listens (default: 5001)
SERVER_PORT=5001
PORT=5001

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# For local development: if left empty, backend automatically initializes
# an in-memory MongoDB server instance for instantaneous zero-config boot.
# For production (MongoDB Atlas):
# Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/krishi_market
MONGODB_URI=mongodb://localhost:27017/krishi_market

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Cryptographic Secrets
# ------------------------------------------------------------------------------
# Generate cryptographically secure 256-bit random keys:
# openssl rand -base64 64
JWT_SECRET=replace-with-a-very-strong-cryptographic-jwt-secret-key-32-chars-min
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-with-a-different-strong-cryptographic-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Client / Frontend URL & CORS Security
# ------------------------------------------------------------------------------
# Origins allowed to make credentialed requests to the backend API.
# In production, set to your canonical frontend domain(s), e.g. https://krishi-market.vercel.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Frontend Vite Configuration
# ------------------------------------------------------------------------------
# Base URL consumed by the Axios HTTP client in the browser.
VITE_API_BASE_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# 6. File Upload Configuration
# ------------------------------------------------------------------------------
# Local disk directory or cloud storage path for uploaded produce photos
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ------------------------------------------------------------------------------
# 7. Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_GENERAL=250
RATE_LIMIT_MAX_CONTACT=10
