# ==============================================================================
# Krishi Market — Backend Environment Variables
# Direct Farmer-to-Consumer Agri Marketplace API
# ==============================================================================

# Runtime Environment (development | production | test)
NODE_ENV=development
SERVER_PORT=5001
PORT=5001

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/krishi_market?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/krishi_market
MONGODB_URI=mongodb://localhost:27017/krishi_market

# Authentication & Cryptographic Tokens
# In production, use high-entropy random strings:
# openssl rand -base64 64
JWT_SECRET=krishi-market-development-jwt-access-secret-2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=krishi-market-development-jwt-refresh-secret-2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (Single origin or comma-separated origins)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
